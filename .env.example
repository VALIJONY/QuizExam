# Nusxa oling:  cp .env.example .env   (python-dotenv o'rnatilgan bo'lishi kerak)
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Tunnel (ngrok) yoki domen bilan ishlatilsa, to'liq manzilni yozing:
DJANGO_CSRF_TRUSTED_ORIGINS=
# DATABASE_PATH=db.sqlite3
